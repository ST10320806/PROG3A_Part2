@model IEnumerable<PROG3A_Part2.Models.Farmer>

@{
    ViewData["Title"] = "Farmer List";
}

<style>
    body {
        margin: 0;
        padding: 0;
        background: linear-gradient(to bottom, #8ec5fc, #e0c3fc);
        min-height: 100vh;
        font-family: Arial, sans-serif;
    }

    .card {
        background-color: white;
        border-radius: 12px;
    }
</style>

<div class="container mt-4">
<h2 class="mb-4">Registered Farmers</h2>

    <table class="table table-bordered table-striped"><!-- Table which displays list of farmers, corrected and debugged ClaudeAi-->
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var farmer in Model)
            {
                <tr>
                    <td>@farmer.Name</td>
                    <td>@farmer.Email</td>
                </tr>
            }
        </tbody>
    </table>

<div class="mt-4">
 <a class="btn btn-success" asp-action="AddFarmer">Add New Farmer</a>
 <a class="btn btn-outline-primary ms-2" asp-action="FilterProducts">Filter Products</a>
</div>
</div>
<!--******************************************************************End Of File******************************************************************-->

@model PROG3A_Part2.Models.Farmer

@{
    ViewData["Title"] = "Add Farmer";
}

<style>
    body {
        margin: 0;
        padding: 0;
        background: linear-gradient(to bottom, #8ec5fc, #e0c3fc);
        min-height: 100vh;
        font-family: Arial, sans-serif;
    }

    .card {
        background-color: white;
        border-radius: 12px;
    }
</style>

<div class="container mt-4">
<h2 class="mb-4">Add a New Farmer</h2>
<form asp-action="AddFarmer" method="post" class="card p-4 shadow-sm">
<div class="form-group mb-3">
  <label>Name</label>
  <input asp-for="Name" class="form-control" required />
 </div>
 <div class="form-group mb-3">
  <label>Email</label>
  <input asp-for="Email" type="email" class="form-control" required />
 </div>
 <div class="form-group mb-3">
  <label>Password</label>
  <input asp-for="Password" type="password" class="form-control" required />
 </div>
  <button type="submit" class="btn btn-success">Create Farmer</button>
  <a asp-action="FarmerList" class="btn btn-secondary ms-2">Cancel</a>
  </form>
</div>
<!--******************************************************************End Of File******************************************************************-->

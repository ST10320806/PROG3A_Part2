@model PROG3A_Part2.Models.Product

@{
    ViewData["Title"] = "Add Product";
}
<!--Gradient creation assisted by Loveable.AI-->
<style>
    body {
        margin: 0;
        padding: 0;
        background: linear-gradient(to bottom, #8ec5fc, #e0c3fc);
        min-height: 100vh;
        font-family: Arial, sans-serif;
    }

    .card {
        background-color: white;
        border-radius: 12px;
    }
</style>

<div class="container mt-4">
    <h2 class="mb-4">Add New Product</h2>

    <form asp-action="AddProduct" method="post" class="card p-4 shadow-sm">
        <div class="form-group mb-3">
            <label>Product Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="form-group mb-3">
            <label>Category</label>
            <input asp-for="Category" class="form-control" required />
        </div>
        <div class="form-group mb-4">
            <label>Production Date</label>
            <input asp-for="ProductionDate" type="date" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-success">Add Product</button>
        <a asp-action="MyProducts" class="btn btn-secondary ms-2">Back to List</a>
    </form>
</div>
<!--******************************************************************End Of File******************************************************************-->
